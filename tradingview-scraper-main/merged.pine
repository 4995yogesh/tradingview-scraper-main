// ─────────────────────────────────────────────────────────────────────────────
// Consolidation Boxes — Merged (Swing-Pivot + WSE v2)  |  Pine Script v6
//
// Detector A — Swing-Pivot (Cons_1):
//   3-bar pivot swing-high/low detection, FVG blocker, IST midnight filter,
//   5-candle formation-phase expansion, range lock, trending-box gates,
//   TIGHT / DRIFT / LOOSE classification, score = touches×0.5 + eff×3.0 − bias×2.0
//
// Detector B — Window Scoring Engine v2 (cons_2):
//   Rolling-window candidate scoring, impulse candle exclusion (Fix 1),
//   internal volatility analysis (Fix 2), internal path quality (Fix 3),
//   10-dimension composite score, multiple simultaneous active boxes.
//
// Shared: IST midnight filter, ATR Cluster Detector, box colours.
// ─────────────────────────────────────────────────────────────────────────────
//@version=6
indicator("Consolidation Boxes — Swing-Pivot + WSE v2", overlay = true,
          max_boxes_count  = 500,
          max_labels_count = 500)

// ── Look-back buffers ────────────────────────────────────────────────────────
max_bars_back(close, 1000)
max_bars_back(high,  1000)
max_bars_back(low,   1000)
max_bars_back(open,  1000)
max_bars_back(time,  1000)

// ════════════════════════════════════════════════════════════════════════════
// SECTION A INPUTS — Swing-Pivot Detector (Cons_1)
// ════════════════════════════════════════════════════════════════════════════
i_A_enable       = input.bool (true, "Enable Swing-Pivot Detector",            group = "A — Swing-Pivot Detector")
i_minBars        = input.int  (6,    "Min Bars",        minval = 2,  maxval = 100,
                                tooltip = "Minimum bars a swing-pivot box must span to be drawn.\n\nLower = very short 2-3 bar micro-boxes are allowed. More boxes appear but many will be tiny and noisy.",
                                group = "A — Swing-Pivot Detector")
i_fvgThresh      = input.float(0.4,  "FVG Threshold",   minval = 0.0, maxval = 1.0, step = 0.05,
                                tooltip = "A Fair Value Gap blocks box formation only if its size >= this fraction of the bar body.\n\nLower = even tiny gaps block a box. Far fewer boxes form near any price gap.",
                                group = "A — Swing-Pivot Detector")
i_timeFilter     = input.bool (true, "Filter IST Midnight (00:00-05:59)",        group = "A — Swing-Pivot Detector")
i_showLabels     = input.bool (true, "Show Type Labels",                         group = "A — Swing-Pivot Detector")
i_showScore      = input.bool (true, "Show Score in Label",                      group = "A — Swing-Pivot Detector")
i_maxConsecDir   = input.int  (4,    "Max Consecutive Directional Closes",
                                minval = 2, maxval = 20,
                                tooltip = "Reject box if this many consecutive closes all move the same direction.\n\nLower = stricter: rejects boxes where price trends for just 2-3 bars. Fewer boxes drawn overall.",
                                group = "A — Swing-Pivot Detector")
i_maxNetMove     = input.float(0.60, "Max Net Displacement Ratio (0-1)",
                                minval = 0.1, maxval = 1.0, step = 0.05,
                                tooltip = "Reject box if net price move / box height exceeds this ratio.\n\nLower = stricter: even a small drift from open to close of the box kills it. Only perfectly sideways boxes survive.",
                                group = "A — Swing-Pivot Detector")

// ════════════════════════════════════════════════════════════════════════════
// SECTION B INPUTS — WSE v2 Detector (cons_2)
// ════════════════════════════════════════════════════════════════════════════
i_B_enable       = input.bool (true,  "Enable WSE v2 Detector",                 group = "B — WSE v2 Detector")
i_maxBars        = input.int  (30,    "Max Window Width",   minval = 5, maxval = 60,
                                tooltip = "How many bars back the engine scans when looking for a box.\n\nLower = only short recent windows are checked. Slow long consolidations are missed.",
                                group = "B — WSE v2 Detector")
i_maxBoxes       = input.int  (100,   "Max Active Boxes",   minval = 1, maxval = 500,
                                tooltip = "Maximum simultaneous live boxes on the chart.\n\nLower = new boxes stop being drawn once this limit is hit. Good for reducing clutter.",
                                group = "B — WSE v2 Detector")
i_scoreThresh    = input.float(1.5,   "Min Quality Score",  minval = -5.0, maxval = 10.0, step = 0.1,
                                tooltip = "Only candidate windows scoring above this are drawn.\n\nLower = more boxes drawn, including weaker and noisier ones. Raise to show only high-confidence zones.",
                                group = "B — WSE v2 Detector")
i_B_maxConsecDir = input.int  (4,     "Consec. Dir Closes - Penalty Ref.",      minval = 2, maxval = 20,
                                tooltip = "Reference for the run-penalty. A directional run of this many bars = full penalty on the score.\n\nLower = even short 2-bar runs heavily penalise the score. Fewer boxes pass.",
                                group = "B — WSE v2 Detector")
i_B_maxNetMove   = input.float(0.60,  "Net Displacement Ratio - Penalty Ref.",  minval = 0.1, maxval = 1.0, step = 0.05,
                                tooltip = "Reference for the displacement-penalty. Net move equal to this fraction of box height = full penalty.\n\nLower = even small endpoint drift destroys the score. Only very flat boxes survive.",
                                group = "B — WSE v2 Detector")
i_atrPeriod      = input.int  (14,    "ATR Period",         minval = 5, maxval = 100,
                                tooltip = "Period for ATR used in compression scoring and impulse detection.\n\nLower = ATR reacts faster. Compression scores fluctuate more with recent volatility changes.",
                                group = "B — WSE v2 Detector")
i_atrScale       = input.float(1.5,   "ATR Scale (compression ref.)", minval = 0.3, maxval = 5.0, step = 0.05,
                                tooltip = "Box height is compared to ATR x this. Smaller ratio = better compression score.\n\nLower = the standard for 'tight enough' drops. More boxes pass compression, even wider ones.",
                                group = "B — WSE v2 Detector")
i_fvgPenalty     = input.float(1.5,   "FVG Score Penalty",  minval = 0.0, maxval = 5.0, step = 0.1,
                                tooltip = "Points subtracted from score when a Fair Value Gap is found inside the window.\n\nLower = FVGs inside the box are forgiven. Boxes with internal price gaps are allowed through.",
                                group = "B — WSE v2 Detector")

// ── FIX 1 — Impulse Candle Exclusion ────────────────────────────────────────
i_impulseGroup      = "B — FIX 1: Impulse Exclusion"
i_impulseAtrMult    = input.float(2.0,  "Impulse ATR Multiplier",   minval = 1.0, maxval = 6.0, step = 0.1,
                                  tooltip = "Bar is an impulse if its true range exceeds ATR x this.\n\nLower = more bars classified as impulse spikes. More windows rejected, fewer boxes drawn.",
                                  group = i_impulseGroup)
i_impulseBodyMult   = input.float(2.5,  "Impulse Body Multiplier",  minval = 1.0, maxval = 8.0, step = 0.1,
                                  tooltip = "Bar is an impulse if its body exceeds avg body x this.\n\nLower = medium-sized candles are flagged as impulse. Stricter - fewer boxes allowed after strong moves.",
                                  group = i_impulseGroup)
i_bodyAvgPeriod     = input.int  (20,   "Body Average Period",       minval = 5,   maxval = 50,
                                  tooltip = "Rolling window for the average body size used in impulse detection.\n\nLower = average adapts faster to recent bars. Impulse detection becomes more sensitive to sudden bursts.",
                                  group = i_impulseGroup)
i_impulseCooldown   = input.int  (4,    "Impulse Cooldown Bars",     minval = 0,   maxval = 20,
                                  tooltip = "Bars to skip after an impulse before allowing a new box.\n\nLower = detection resumes sooner after a spike. Boxes can appear faster but may still be in volatile price action.",
                                  group = i_impulseGroup)
i_rejectImpulseAnch = input.bool (true, "Reject Windows Starting With Impulse",
                                  tooltip = "When ON, any window whose oldest bar is an impulse candle is discarded entirely.",
                                  group = i_impulseGroup)

// ── FIX 2 — Internal Volatility Quality ─────────────────────────────────────
i_volGroup       = "B — FIX 2: Internal Volatility"
i_volPenWeight   = input.float(2.5,  "Internal Vol Penalty Weight",      minval = 0.0, maxval = 5.0, step = 0.1,
                                tooltip = "How heavily internal chaos (ATR drift, uneven candles, wick spikes) penalises the score.\n\nLower = messy interiors are forgiven. Volatile, chaotic boxes still pass.",
                                group = i_volGroup)
i_wickChaosThresh= input.float(0.60, "Wick Chaos Height Fraction",       minval = 0.2, maxval = 1.0, step = 0.05,
                                tooltip = "A candle is chaotic if its high-low range >= this fraction of box height.\n\nLower = even medium-ranged candles are counted as chaotic. Boxes with normal wicks get penalised more.",
                                group = i_volGroup)
i_atrDriftThresh = input.float(1.30, "Internal ATR Expansion Threshold", minval = 1.0, maxval = 3.0, step = 0.05,
                                tooltip = "If ATR at box end > ATR at box start x this, volatility is expanding (bad).\n\nLower = even a tiny ATR increase inside the box triggers the drift penalty. Very strict quality filter.",
                                group = i_volGroup)

// ── FIX 3 — Internal Path Quality ───────────────────────────────────────────
i_pathGroup      = "B — FIX 3: Path Quality"
i_pathSmoothRef  = input.float(3.0,  "Path Smoothness Ref. Ratio", minval = 1.5, maxval = 10.0, step = 0.5,
                                tooltip = "Path / net displacement. At or above this ratio the price is fully oscillatory (good).\n\nLower = weakly oscillating price still gets full smoothness credit. Less separation between clean and choppy boxes.",
                                group = i_pathGroup)
i_midCrossMin    = input.float(0.15, "Min Midpoint Cross Fraction", minval = 0.0, maxval = 0.5,  step = 0.05,
                                tooltip = "Fraction of bars that must cross the box midpoint to earn a mean-reversion bonus.\n\nLower = even rare midpoint crossings earn the bonus. Boxes where price barely visits the middle score well.",
                                group = i_pathGroup)
i_entropyWeight  = input.float(1.5,  "Path Quality Bonus Weight",   minval = 0.0, maxval = 3.0,  step = 0.1,
                                tooltip = "Maximum bonus added for excellent path quality (balanced moves, midpoint crossings, smooth oscillation).\n\nLower = path quality contributes less. Boxes with one-sided or choppy moves are penalised less.",
                                group = i_pathGroup)

// ════════════════════════════════════════════════════════════════════════════
// SHARED — Box Colours
// ════════════════════════════════════════════════════════════════════════════
i_colTightBg = input.color(color.new(color.green, 85), "TIGHT Fill",   group = "Colors")
i_colLooseBg = input.color(color.new(#FF6D00,     85), "LOOSE Fill",   group = "Colors")
i_colDriftBg = input.color(color.new(color.red,   85), "DRIFT Fill",   group = "Colors")
i_colTightBd = input.color(color.new(color.green,  0), "TIGHT Border", group = "Colors")
i_colLooseBd = input.color(color.new(#FF6D00,      0), "LOOSE Border", group = "Colors")
i_colDriftBd = input.color(color.new(color.red,    0), "DRIFT Border", group = "Colors")

// ════════════════════════════════════════════════════════════════════════════
// SHARED — ATR Cluster Detector
// ════════════════════════════════════════════════════════════════════════════
i_clEnable  = input.bool (true,  "Enable Cluster Detector",              group = "Cluster Detector")
i_clMinBars = input.int  (5,     "Min Bars in Cluster",   minval = 3,  maxval = 50,
                           tooltip = "A cluster zone must span at least this many bars.\n\nLower = even 3-bar micro-clusters are accepted. More small tight zones appear on the chart.",
                           group = "Cluster Detector")
i_clMaxBars = input.int  (20,    "Max Look-Back Window",  minval = 5,  maxval = 100,
                           tooltip = "How far back the cluster detector scans for a tight zone.\n\nLower = only short recent clusters are found. Older or longer flat zones are ignored.",
                           group = "Cluster Detector")
i_clAtrMult = input.float(0.5,   "Max Range (x ATR 14)", minval = 0.1, maxval = 5.0, step = 0.05,
                           tooltip = "Cluster passes only if its high-low range < ATR(14) x this.\n\nLower = only ultra-tight compressed zones qualify. Even slightly wider flat areas are rejected.",
                           group = "Cluster Detector")
i_clMaxCDir = input.int  (4,     "Max Consec Dir Closes", minval = 2,  maxval = 20,
                           tooltip = "Cluster is rejected if closes run one direction for this many bars in a row.\n\nLower = even 2 consecutive same-direction closes kill the cluster. Very few clusters drawn.",
                           group = "Cluster Detector")
i_clMaxNet  = input.float(0.60,  "Max Net Displacement",  minval = 0.1, maxval = 1.0, step = 0.05,
                           tooltip = "Cluster rejected if net price move / cluster height exceeds this.\n\nLower = only perfectly flat clusters qualify. Any slight directional drift disqualifies the zone.",
                           group = "Cluster Detector")
i_clBg      = input.color(color.new(#006D75, 85), "Cluster Fill",   group = "Cluster Detector")
i_clBd      = input.color(color.new(#00BCD4,  0), "Cluster Border", group = "Cluster Detector")

// ════════════════════════════════════════════════════════════════════════════
// SHARED HELPERS
// ════════════════════════════════════════════════════════════════════════════
_istHour() =>
    int istMs = int(time) + 19800000
    int(istMs / 3600000) % 24

isBlockedTime = i_timeFilter ? _istHour() < 6 : false

// Root-level ATRs (keep look-back buffers warm)
float atrMain = ta.atr(i_atrPeriod)
float atr14   = ta.atr(14)

// ════════════════════════════════════════════════════════════════════════════
// DETECTOR B — FIX 1: GLOBAL IMPULSE STATE
// ════════════════════════════════════════════════════════════════════════════
var float bodyRollingSum = 0.0
float     currentBody    = math.abs(close - open)
bodyRollingSum := bodyRollingSum + currentBody - math.abs(close[i_bodyAvgPeriod] - open[i_bodyAvgPeriod])
float avgBody = bodyRollingSum / float(i_bodyAvgPeriod)

float currentTR = math.max(high - low,
                   math.max(math.abs(high - close[1]),
                            math.abs(low  - close[1])))

bool isImpulseBar = (currentTR   > atrMain * i_impulseAtrMult) or
                    (currentBody > avgBody  * i_impulseBodyMult and avgBody > 0.0)

var int barsSinceImpulse = i_impulseCooldown + 1
barsSinceImpulse := isImpulseBar ? 0 : barsSinceImpulse + 1
bool inImpulseCooldown = barsSinceImpulse <= i_impulseCooldown

// ════════════════════════════════════════════════════════════════════════════
// PER-BAR SIGNALS (used by Detector A)
// ════════════════════════════════════════════════════════════════════════════
isSwingHigh = high[1] > high[2] and high[1] >= high
isSwingLow  = low[1]  < low[2]  and low[1]  <= low

bullishFVG  = low  > high[2]
bearishFVG  = high < low[2]
bullFvgSize = bullishFVG ? low   - high[2] : 0.0
bearFvgSize = bearishFVG ? low[2] - high   : 0.0
bodySize    = math.abs(close - open)
smallBull   = bullishFVG and bullFvgSize < bodySize * i_fvgThresh
smallBear   = bearishFVG and bearFvgSize < bodySize * i_fvgThresh
validFVG    = (bullishFVG and not smallBull) or (bearishFVG and not smallBear)

// ════════════════════════════════════════════════════════════════════════════
// DETECTOR A STATE
// ════════════════════════════════════════════════════════════════════════════
var bool  searchingSwings = true
var int   anchorIndex     = 0
var bool  gotSwingHigh    = false
var bool  gotSwingLow     = false
var float swingHighVal    = na
var float swingLowVal     = na
var int   firstSwingIndex = na
var bool  active          = false
var box   activeBox       = na
var float rangeTop        = na
var float rangeBottom     = na
var bool  fvgBlocked      = false
var bool  boxStarted      = false
var int   activeBoxStart  = na

// ════════════════════════════════════════════════════════════════════════════
// DETECTOR B STATE
// ════════════════════════════════════════════════════════════════════════════
var int[]   boxLeft   = array.new_int()
var int[]   boxRight  = array.new_int()
var float[] boxTop    = array.new_float()
var float[] boxBottom = array.new_float()
var float[] boxScore  = array.new_float()
var bool[]  boxActive = array.new_bool()
var box[]   boxObj    = array.new_box()
var label[] boxLbl    = array.new_label()

// Cluster deduplication state (shared across both detectors)
var int   clLastRight  = na
var int   clLastLeft   = na
var float clLastTop    = na
var float clLastBottom = na

// ════════════════════════════════════════════════════════════════════════════
// DETECTOR A — STEP 1: EXTEND OR TERMINATE ACTIVE BOX
// ════════════════════════════════════════════════════════════════════════════
if i_A_enable and active
    if close > rangeTop or close < rangeBottom or isBlockedTime
        if not na(activeBox)
            int   dist      = bar_index - activeBoxStart
            float actualTop = rangeTop
            float actualBot = rangeBottom
            for bOff = 1 to dist
                if high[bOff] > actualTop
                    actualTop := high[bOff]
                if low[bOff]  < actualBot
                    actualBot := low[bOff]
            box.set_top   (activeBox, actualTop)
            box.set_bottom(activeBox, actualBot)
            box.set_right (activeBox, bar_index - 1)

        active          := false
        activeBox       := na
        rangeTop        := na
        rangeBottom     := na
        searchingSwings := true
        boxStarted      := false
        gotSwingHigh    := false
        gotSwingLow     := false
        swingHighVal    := na
        swingLowVal     := na
        firstSwingIndex := na
        anchorIndex     := bar_index

    else
        int age = bar_index - activeBoxStart + 1
        if age <= 5
            if high > rangeTop
                rangeTop := high
                if not na(activeBox)
                    box.set_top(activeBox, rangeTop)
            if low < rangeBottom
                rangeBottom := low
                if not na(activeBox)
                    box.set_bottom(activeBox, rangeBottom)
        if not na(activeBox)
            box.set_right(activeBox, bar_index)

// DETECTOR A — STEP 2: RESET IN BLOCKED TIME
if i_A_enable and not active and isBlockedTime
    anchorIndex     := bar_index
    gotSwingHigh    := false
    gotSwingLow     := false
    swingHighVal    := na
    swingLowVal     := na
    firstSwingIndex := na
    rangeTop        := na
    rangeBottom     := na
    fvgBlocked      := false
    boxStarted      := false

// DETECTOR A — STEP 3: FVG BLOCKER
if i_A_enable and not boxStarted and validFVG and not isBlockedTime
    fvgBlocked := true

// DETECTOR A — STEP 4: SEARCH PHASE
if i_A_enable and searchingSwings and not active and bar_index > anchorIndex and not isBlockedTime

    int swingBarIndex = bar_index - 1

    if swingBarIndex > anchorIndex
        if not gotSwingHigh and isSwingHigh
            gotSwingHigh    := true
            swingHighVal    := high[1]
            if na(firstSwingIndex)
                firstSwingIndex := swingBarIndex
        if not gotSwingLow and isSwingLow
            gotSwingLow     := true
            swingLowVal     := low[1]
            if na(firstSwingIndex)
                firstSwingIndex := swingBarIndex

    if fvgBlocked
        anchorIndex     := bar_index
        gotSwingHigh    := false
        gotSwingLow     := false
        swingHighVal    := na
        swingLowVal     := na
        firstSwingIndex := na
        rangeTop        := na
        rangeBottom     := na
        fvgBlocked      := false

    else if gotSwingHigh and gotSwingLow and not na(firstSwingIndex)

        int   span      = bar_index - firstSwingIndex + 1
        float tempHigh  = swingHighVal
        float tempLow   = swingLowVal
        int   cnt       = 0
        bool  allInside = true

        for k = 0 to span - 1
            int   bOff    = span - 1 - k
            int   posInBox = k + 1
            float ck = close[bOff]
            float hk = high[bOff]
            float lk = low[bOff]
            if tempLow <= ck and ck <= tempHigh
                if posInBox <= 5
                    if lk < tempLow
                        tempLow  := lk
                    if hk > tempHigh
                        tempHigh := hk
                cnt += 1
            else
                allInside := false
                break

        if allInside and cnt >= i_minBars
            int  maxRun = 0
            int  curRun = 0
            int  curDir = 0
            for k = 1 to span - 1
                int   bOffPrev = span - 1 - (k - 1)
                int   bOffCurr = span - 1 - k
                float cPrev    = close[bOffPrev]
                float cCurr    = close[bOffCurr]
                int   dir      = cCurr < cPrev ? -1 : cCurr > cPrev ? 1 : 0
                if dir != 0
                    if dir == curDir
                        curRun += 1
                    else
                        curRun := 1
                        curDir := dir
                    if curRun > maxRun
                        maxRun := curRun
                else
                    curRun := 0

            float netMove    = math.abs(close - close[span - 1])
            float netMoveRng = tempHigh - tempLow
            float netRatio   = netMoveRng > 0 ? netMove / netMoveRng : 0.0
            bool  trendingBox = maxRun >= i_maxConsecDir or netRatio > i_maxNetMove

            if not trendingBox
                swingHighVal    := tempHigh
                swingLowVal     := tempLow
                rangeTop        := swingHighVal
                rangeBottom     := swingLowVal
                active          := true
                searchingSwings := false
                boxStarted      := true
                activeBoxStart  := firstSwingIndex

                float rng_v      = rangeTop - rangeBottom
                float tightness  = rng_v / (close + 1e-9)
                float displacement = math.abs(close - close[span - 1])

                float pathLen = 0.0
                for k = 0 to span - 2
                    pathLen += math.abs(close[span - 1 - k] - close[span - 2 - k])
                pathLen += 1e-9

                float efficiency = displacement / pathLen

                float bodySum = 0.0
                for k = 0 to span - 1
                    bodySum += math.abs(close[span - 1 - k] - open[span - 1 - k])
                float bodyAvg = bodySum / span
                float bias    = bodyAvg / (rng_v + 1e-9)

                float touchThresh = rng_v * 0.05
                int   touches     = 0
                for k = 0 to span - 1
                    int bOff = span - 1 - k
                    if rangeTop - high[bOff] < touchThresh
                        touches += 1
                    if low[bOff] - rangeBottom < touchThresh
                        touches += 1

                float score   = float(touches) * 0.5 + efficiency * 3.0 - bias * 2.0
                score        := math.round(score * 100.0) / 100.0

                string boxType = "LOOSE"
                if tightness < 0.005 and touches >= 4
                    boxType := "TIGHT"
                else if efficiency < 0.4 and bias > 0.3
                    boxType := "DRIFT"

                color bgCol = switch boxType
                    "TIGHT" => i_colTightBg
                    "DRIFT" => i_colDriftBg
                    =>         i_colLooseBg
                color bdCol = switch boxType
                    "TIGHT" => i_colTightBd
                    "DRIFT" => i_colDriftBd
                    =>         i_colLooseBd

                activeBox := box.new(
                     left         = firstSwingIndex,
                     top          = rangeTop,
                     right        = bar_index,
                     bottom       = rangeBottom,
                     border_color = bdCol,
                     bgcolor      = bgCol,
                     border_width = 1,
                     xloc         = xloc.bar_index,
                     extend       = extend.none)

                if i_showLabels
                    string scoreStr = i_showScore ? " (" + str.tostring(score) + ")" : ""
                    label.new(
                         x         = firstSwingIndex,
                         y         = rangeTop,
                         text      = boxType + scoreStr,
                         color     = color.new(bdCol, 80),
                         textcolor = bdCol,
                         style     = label.style_label_right,
                         size      = size.tiny,
                         xloc      = xloc.bar_index)

// ════════════════════════════════════════════════════════════════════════════
// DETECTOR B — STEP 1: UPDATE ACTIVE BOXES (Extend or Terminate)
// ════════════════════════════════════════════════════════════════════════════
int nActive   = 0
int nBoxTotal = array.size(boxActive)

if i_B_enable and nBoxTotal > 0
    for i = 0 to nBoxTotal - 1
        if array.get(boxActive, i)
            float bt = array.get(boxTop,    i)
            float bb = array.get(boxBottom, i)
            if close > bt or close < bb or isBlockedTime
                array.set(boxActive, i, false)
                int   bLeft   = array.get(boxLeft, i)
                int   dist    = bar_index - bLeft
                int   distCap = math.min(dist, 499)
                float actTop  = bt
                float actBot  = bb
                for bOff = 1 to distCap
                    if high[bOff] > actTop
                        actTop := high[bOff]
                    if low[bOff]  < actBot
                        actBot := low[bOff]
                box bx = array.get(boxObj, i)
                if not na(bx)
                    box.set_right (bx, bar_index - 1)
                    box.set_top   (bx, actTop)
                    box.set_bottom(bx, actBot)
                array.set(boxRight,  i, bar_index - 1)
                array.set(boxTop,    i, actTop)
                array.set(boxBottom, i, actBot)
            else
                nActive += 1
                box bx = array.get(boxObj, i)
                if not na(bx)
                    box.set_right(bx, bar_index)
                array.set(boxRight, i, bar_index)

// ════════════════════════════════════════════════════════════════════════════
// DETECTOR B — STEP 2: WINDOW SCORING ENGINE (WSE v2)
// ════════════════════════════════════════════════════════════════════════════
if i_B_enable and nActive < i_maxBoxes and not isBlockedTime and not inImpulseCooldown and bar_index > i_maxBars + i_bodyAvgPeriod + 2

    float wHi = high[1]
    float wLo = low[1]
    for k = 2 to i_minBars - 1
        if high[k] > wHi
            wHi := high[k]
        if low[k]  < wLo
            wLo := low[k]

    float bestScore = -999.0
    int   bestW     = 0
    float bestHi    = na
    float bestLo    = na
    float bestComp  = 0.0
    float bestDisp  = 0.0
    float bestEff   = 0.0
    float bestBound = 0.0

    for w = i_minBars to i_maxBars
        if high[w] > wHi
            wHi := high[w]
        if low[w]  < wLo
            wLo := low[w]

        float rangeH = wHi - wLo
        if rangeH <= 0.0
            continue

        if i_timeFilter
            int wIstMs = int(time[w]) + 19800000
            int wIstHr = int(wIstMs / 3600000) % 24
            if wIstHr < 6
                continue

        // FIX 1A — Impulse anchor rejection
        if i_rejectImpulseAnch
            float anchorBody = math.abs(close[w] - open[w])
            float anchorTR   = math.max(high[w] - low[w],
                               math.max(math.abs(high[w] - close[w + 1]),
                                        math.abs(low[w]  - close[w + 1])))
            float anchorATR  = atrMain[w]
            float anchorAvgBd = avgBody[w]
            bool anchorIsImpulse = (anchorTR   > anchorATR   * i_impulseAtrMult) or
                                   (anchorBody > anchorAvgBd * i_impulseBodyMult and anchorAvgBd > 0.0)
            if anchorIsImpulse
                continue

        // Overlap check
        int  wLeft   = bar_index - w
        int  wRight  = bar_index - 1
        bool skipWin = false
        int  nBx     = array.size(boxActive)
        if nBx > 0
            for i = 0 to nBx - 1
                bool isAct  = array.get(boxActive, i)
                int  er     = array.get(boxRight,  i)
                bool recent = not isAct and er >= bar_index - i_maxBars
                if isAct or recent
                    int   el   = array.get(boxLeft,   i)
                    float et   = array.get(boxTop,    i)
                    float eb   = array.get(boxBottom, i)
                    if el <= wRight and er >= wLeft and et >= wLo and eb <= wHi
                        skipWin := true
                        break
        if skipWin
            continue

        // Wick Breach Penalty
        float breachSum = 0.0
        for k = 1 to w
            float ck = close[k]
            float hk = high[k]
            float lk = low[k]
            if ck > wHi
                breachSum += (ck - wHi) / rangeH * 3.0
            else if ck < wLo
                breachSum += (wLo - ck) / rangeH * 3.0
            else
                if hk > wHi
                    breachSum += (hk - wHi) / rangeH * 0.5
                if lk < wLo
                    breachSum += (wLo - lk) / rangeH * 0.5
        float wickPen = math.min(breachSum / float(w), 1.0)
        if wickPen > 0.85
            continue

        // Single-pass close-series metrics
        int   maxRun  = 0
        int   curRun  = 0
        int   curDir  = 0
        int   prevDir = 0
        int   dirChgs = 0
        float pathLen = 0.0
        int   upMoves = 0
        int   dnMoves = 0
        for k = 1 to w - 1
            float cNew  = close[k]
            float cOld  = close[k + 1]
            float delta = cNew - cOld
            pathLen += math.abs(delta)
            int dir = delta > 0.0 ? 1 : delta < 0.0 ? -1 : 0
            if dir != 0
                if dir == 1
                    upMoves += 1
                else
                    dnMoves += 1
                if dir == curDir
                    curRun += 1
                else
                    if curRun > maxRun
                        maxRun := curRun
                    curRun := 1
                    curDir := dir
                if prevDir != 0 and dir != prevDir
                    dirChgs += 1
                prevDir := dir
            else
                if curRun > maxRun
                    maxRun := curRun
                curRun := 0
        if curRun > maxRun
            maxRun := curRun

        float runPen    = math.min(float(maxRun) / float(i_B_maxConsecDir), 1.0)
        float oscScore  = math.min(float(dirChgs) / math.max(float(w - 1) * 0.5, 1.0), 1.0)
        float netDisp   = math.abs(close[1] - close[w])
        float dispPen   = math.min((netDisp / rangeH) / i_B_maxNetMove, 1.0)
        float noiseScore = 1.0 - math.min(netDisp / (pathLen + 1e-9), 1.0)

        // Compression Score
        float compRef   = atrMain * i_atrScale
        float compScore = 1.0 - math.min(rangeH / compRef, 1.0)

        // Boundary Interaction Score
        float touchThr   = rangeH * 0.08
        int   topTch     = 0
        int   botTch     = 0
        for k = 1 to w
            if high[k] >= wHi - touchThr
                topTch += 1
            if low[k]  <= wLo + touchThr
                botTch += 1
        float boundScore = math.min(float(topTch + botTch) / math.max(float(w) * 0.4, 1.0), 1.0)

        // FVG Penalty
        float fvgPen = 0.0
        for k = 1 to w - 2
            float bodyK  = math.abs(close[k] - open[k])
            bool  bullFg = low[k]  > high[k + 2]
            bool  bearFg = high[k] < low[k + 2]
            if bullFg or bearFg
                float fvgSz = bullFg ? low[k] - high[k + 2] : low[k + 2] - high[k]
                if fvgSz >= bodyK * i_fvgThresh
                    fvgPen := i_fvgPenalty
                    break

        // FIX 2 — Internal Volatility
        float atrStart      = atrMain[w]
        float atrEnd        = atrMain[1]
        float atrDriftRatio = atrEnd / math.max(atrStart, 1e-9)
        float atrDriftPen   = math.min(math.max(atrDriftRatio - i_atrDriftThresh, 0.0) /
                              math.max(i_atrDriftThresh - 1.0, 0.001), 1.0)

        float sumRanges  = 0.0
        float sumRangeSq = 0.0
        int   wickChaos  = 0
        for k = 1 to w
            float barRange = high[k] - low[k]
            sumRanges     += barRange
            sumRangeSq    += barRange * barRange
            if barRange >= rangeH * i_wickChaosThresh
                wickChaos += 1
        float meanRange          = sumRanges  / float(w)
        float rangeVar           = math.max(sumRangeSq / float(w) - meanRange * meanRange, 0.0)
        float rangeUniformityPen = math.min(math.sqrt(rangeVar) / math.max(rangeH, 1e-9), 1.0)

        float preBoxATR  = atrMain[w + 1]
        float comprRatio = meanRange / math.max(preBoxATR, 1e-9)
        float comprPen   = math.min(math.max(comprRatio - 0.8, 0.0) / 0.7, 1.0)

        float wickChaosPen       = math.min(float(wickChaos) / math.max(float(w) * 0.5, 1.0), 1.0)
        float internalVolPenalty = (atrDriftPen + rangeUniformityPen + comprPen + wickChaosPen) * 0.25

        // FIX 3 — Path Quality
        float pathRatio    = pathLen / math.max(netDisp, rangeH * 0.01)
        float smoothScore  = math.min(pathRatio / math.max(i_pathSmoothRef, 1.0), 1.0)

        float boxMid       = (wHi + wLo) * 0.5
        int   midCrossings = 0
        for k = 1 to w - 1
            if (close[k] >= boxMid) != (close[k + 1] >= boxMid)
                midCrossings += 1
        float midCrossFrac   = float(midCrossings) / math.max(float(w - 1), 1.0)
        float midRevScore    = math.min(midCrossFrac / math.max(i_midCrossMin * 2.0, 0.001), 1.0)

        int   totalMoves   = upMoves + dnMoves
        float entropyScore = totalMoves > 0 ?
                             1.0 - float(math.abs(upMoves - dnMoves)) / float(totalMoves) : 0.5

        float pathQualityBonus = (smoothScore + midRevScore + entropyScore) * 0.3333 * i_entropyWeight

        // Composite Score (10 dimensions)
        float score = compScore           * 3.5 +
                      oscScore            * 2.0 +
                      boundScore          * 1.5 +
                      noiseScore          * 1.0 +
                      pathQualityBonus         -
                      runPen             * 2.0 -
                      dispPen            * 2.0 -
                      wickPen            * 3.0 -
                      internalVolPenalty * i_volPenWeight -
                      fvgPen

        if score >= i_scoreThresh and score > bestScore
            bestScore := score
            bestW     := w
            bestHi    := wHi
            bestLo    := wLo
            bestComp  := compScore
            bestDisp  := dispPen
            bestEff   := noiseScore
            bestBound := boundScore

    // Activate best window
    if bestW >= i_minBars
        int   wLeft = bar_index - bestW
        int   wRight = bar_index - 1
        float wTop   = bestHi
        float wBot   = bestLo

        string boxType = "LOOSE"
        if bestComp > 0.65 and bestBound > 0.45
            boxType := "TIGHT"
        else if bestDisp > 0.55 and bestEff < 0.35
            boxType := "DRIFT"

        color bgCol = switch boxType
            "TIGHT" => i_colTightBg
            "DRIFT" => i_colDriftBg
            =>         i_colLooseBg
        color bdCol = switch boxType
            "TIGHT" => i_colTightBd
            "DRIFT" => i_colDriftBd
            =>         i_colLooseBd

        float scoreRnd = math.round(bestScore * 100.0) / 100.0

        box newBox = box.new(
             left         = wLeft,
             top          = wTop,
             right        = bar_index,
             bottom       = wBot,
             border_color = bdCol,
             bgcolor      = bgCol,
             border_width = 1,
             xloc         = xloc.bar_index,
             extend       = extend.none)

        label newLbl = na
        if i_showLabels
            string lbTxt = boxType + (i_showScore ? " (" + str.tostring(scoreRnd) + ")" : "")
            newLbl := label.new(
                 x         = wLeft,
                 y         = wTop,
                 text      = lbTxt,
                 color     = color.new(bdCol, 80),
                 textcolor = bdCol,
                 style     = label.style_label_right,
                 size      = size.tiny,
                 xloc      = xloc.bar_index)

        array.push(boxLeft,   wLeft)
        array.push(boxRight,  bar_index)
        array.push(boxTop,    wTop)
        array.push(boxBottom, wBot)
        array.push(boxScore,  bestScore)
        array.push(boxActive, true)
        array.push(boxObj,    newBox)
        array.push(boxLbl,    newLbl)

// ════════════════════════════════════════════════════════════════════════════
// SHARED — ATR CLUSTER DETECTOR
// ════════════════════════════════════════════════════════════════════════════
if i_clEnable and not isBlockedTime

    int   clBestN     = 0
    float clBestHi    = na
    float clBestLo    = na
    float clBestScore = na

    for n = i_clMinBars to i_clMaxBars
        float wHi = high[1]
        float wLo = low[1]
        for idx = 2 to n
            if high[idx] > wHi
                wHi := high[idx]
            if low[idx]  < wLo
                wLo := low[idx]

        float wHt = wHi - wLo
        if wHt > 0 and wHt < atr14 * i_clAtrMult
            int clStart = bar_index - n
            int clEnd   = bar_index - 1

            bool tOvlp    = not na(clLastLeft)   and not na(clLastRight)  and
                            clStart <= clLastRight and clEnd >= clLastLeft
            bool pOvlp    = not na(clLastTop)    and not na(clLastBottom) and
                            wHi >= clLastBottom   and wLo <= clLastTop
            if not (tOvlp and pOvlp)
                int   clMaxRun = 0
                int   clCurRun = 0
                int   clCurDir = 0
                for k = 1 to n - 1
                    float cp = close[n - (k - 1)]
                    float cc = close[n - k]
                    int   dd = cc < cp ? -1 : cc > cp ? 1 : 0
                    if dd != 0
                        if dd == clCurDir
                            clCurRun += 1
                        else
                            clCurRun := 1
                            clCurDir := dd
                        if clCurRun > clMaxRun
                            clMaxRun := clCurRun
                    else
                        clCurRun := 0

                float clNet   = math.abs(close[1] - close[n])
                float clRatio = clNet / wHt
                if not (clMaxRun >= i_clMaxCDir or clRatio > i_clMaxNet)
                    float clTouchThr = wHt * 0.10
                    int   clTouches  = 0
                    for k = 1 to n
                        if wHi - high[k] <= clTouchThr
                            clTouches += 1
                        if low[k] - wLo  <= clTouchThr
                            clTouches += 1

                    float clPath = 0.0
                    for k = 1 to n - 1
                        clPath += math.abs(close[k] - close[k + 1])

                    float clEff        = clPath > 0 ? clNet / clPath : 1.0
                    float clCompact    = 1.0 - math.min(wHt / (atr14 * i_clAtrMult), 1.0)
                    float clOsc        = 1.0 - math.min(clRatio, 1.0)
                    float clRunPenalty = float(clMaxRun) / float(i_clMaxCDir)
                    float clScore = clCompact * 3.0 +
                                    clOsc     * 2.0 +
                                    float(clTouches) * 0.25 +
                                    float(n)  * 0.05 -
                                    clEff     * 1.5 -
                                    clRunPenalty

                    if na(clBestScore) or clScore > clBestScore
                        clBestScore := clScore
                        clBestN     := n
                        clBestHi    := wHi
                        clBestLo    := wLo

    if clBestN >= i_clMinBars
        int clStart = bar_index - clBestN
        int clEnd   = bar_index - 1

        box.new(
             left         = clStart,
             top          = clBestHi,
             right        = clEnd,
             bottom       = clBestLo,
             border_color = i_clBd,
             bgcolor      = i_clBg,
             border_width = 1,
             xloc         = xloc.bar_index,
             extend       = extend.none)

        clLastLeft   := clStart
        clLastRight  := clEnd
        clLastTop    := clBestHi
        clLastBottom := clBestLo

        if i_showLabels
            label.new(
                 x         = clStart,
                 y         = clBestHi,
                 text      = "CLUSTER",
                 color     = color.new(i_clBd, 80),
                 textcolor = i_clBd,
                 style     = label.style_label_right,
                 size      = size.tiny,
                 xloc      = xloc.bar_index)
